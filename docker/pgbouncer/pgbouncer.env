POOL_MODE=transaction
MAX_CLIENT_CONN=5000
DEFAULT_POOL_SIZE=25
MIN_POOL_SIZE=5
RESERVE_POOL_SIZE=5

SERVER_LIFETIME=3600
SERVER_IDLE_TIMEOUT=600
MAX_PREPARED_STATEMENTS=100

VERBOSE=0
LOG_CONNECTIONS=0
LOG_DISCONNECTIONS=0
LOG_STATS=1
STATS_PERIOD=60

IGNORE_STARTUP_PARAMETERS=extra_float_digits,client_encoding,timezone
AUTH_TYPE=scram-sha-256
LISTEN_PORT=6432
LISTEN_ADDR=*
